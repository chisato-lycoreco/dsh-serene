{
  "name": "dsh-serene",
  "version": "0.6.0",
  "description": "人格 + 情感 + 记忆的 DeepSeek Harness 插件：把「一个会记得你的角色」接进 DSH。附带可直接开局的人格包「知遥」。",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    "./core/emotion": "./core/emotion.js",
    "./core/recall": "./core/recall.js",
    "./core/motivation": "./core/motivation.js",
    "./core/life": "./core/life.js",
    "./core/mental": "./core/mental.js",
    "./core/lexicon": "./core/lexicon.js",
    "./core/style": "./core/style.js",
    "./core/crisis": "./core/crisis.js",
    "./core/almanac": "./core/almanac.js",
    "./core/weather": "./core/weather.js",
    "./core/beliefs": "./core/beliefs.js",
    "./core/profile": "./core/profile.js",
    "./core/introspect": "./core/introspect.js",
    "./package.json": "./package.json",
    ".": "./src/index.js"
  },
  "files": [
    "src/",
    "core/",
    "personas/",
    "web/",
    "start-web.cmd",
    "start-web.sh",
    "start-web.command",
    "start-web-demo.cmd",
    "start-web-demo.sh",
    "start-web-demo.command",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "FRAMEWORK.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=22.19"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js",
    "demo": "node demo/timeline.mjs",
    "preview": "node demo/render.mjs",
    "web": "node web/server.mjs",
    "web:demo": "node web/server.mjs --demo",
    "shots": "node scripts/shots.mjs",
    "prepublishOnly": "npm test",
    "opening": "node demo/opening.mjs",
    "art": "node scripts/art.mjs && node scripts/art.mjs --en"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "persona",
    "companion",
    "agent-memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chisato-lycoreco/dsh-serene.git"
  },
  "bugs": {
    "url": "https://github.com/chisato-lycoreco/dsh-serene/issues"
  },
  "homepage": "https://github.com/chisato-lycoreco/dsh-serene#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
